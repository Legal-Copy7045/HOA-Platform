# =============================================================================
# Oak Creek Farms HOA portal - environment configuration
#
# Copy to .env for local development:   cp .env.example .env
# The values below are LOCAL-DEVELOPMENT PLACEHOLDERS. They protect nothing.
# On any shared host (POC VM, production) generate every secret fresh, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Never commit a real .env. Production settings refuse placeholder values.
# =============================================================================

# --- Django ------------------------------------------------------------------
# Settings module: core.settings.local (localhost only) or core.settings.production.
DJANGO_SETTINGS_MODULE=core.settings.local
# Cryptographic signing key. Production requires 50+ random characters and
# rejects anything starting with "dev-insecure".
DJANGO_SECRET_KEY=dev-insecure-local-only-change-me-for-any-shared-host-000000
# Must be false outside local development. Production refuses true.
DJANGO_DEBUG=true
# Comma-separated hostnames the site answers to. Production: the public hostname only.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated scheme+host origins for CSRF, e.g. https://portal-dev.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=
# Display name used in page titles and emails.
SITE_NAME=Oak Creek Farms HOA
# Public address of the portal, used in emailed links (no trailing slash).
PORTAL_BASE_URL=http://localhost:8000
# How long an invitation link stays valid, in hours (default 7 days).
INVITE_TTL_HOURS=168
# Two-person flows: how long a sysadmin nomination and an MFA reset request
# wait for a second board member, and how long an enrollment code lasts.
SYSADMIN_NOMINATION_TTL_DAYS=7
MFA_RESET_REQUEST_TTL_DAYS=7
MFA_RESET_CODE_TTL_HOURS=24
# Community's local time zone (IANA name).
TIME_ZONE=America/New_York
# DEBUG, INFO, WARNING or ERROR. Logs are JSON on stdout without personal data.
LOG_LEVEL=INFO
# Django admin. Local development convenience only; production refuses true (decision Q9).
ADMIN_ENABLED=false
# URL prefix for the admin when enabled (trailing slash required).
ADMIN_URL=admin/

# Allow `manage.py seed_demo` (fictional data). true on local and the POC
# only; never in production. With production settings it is honoured only
# when DEPLOYMENT_STAGE=poc.
SEED_DEMO_ALLOWED=true
# DEPLOYMENT_STAGE=poc
# Shown on the sysadmin status page (start-portal.sh sets the git commit).
APP_VERSION=dev
# Hour (site time) at which "Install tonight" on System status installs an update.
UPDATE_NIGHTLY_HOUR=4

# --- Audit log (decision D7) -------------------------------------------------
# Secret key for hashing identifiers that must not be stored in clear (e.g. the
# email typed in a failed login for a non-existent account). Production requires
# 32+ random characters. Changing it breaks matching against older hashes.
AUDIT_HASH_KEY=dev-insecure-local-audit-hash-key-0000000000
# Days to keep IP addresses on audit events before the daily purge removes them.
AUDIT_IP_RETENTION_DAYS=365

# --- Governance rules (from the Declaration/bylaws; CLAUDE.md rule 6) --------
# Officers must hold an active board seat (decision D1). Set false only if the
# bylaws allow non-director officers, and cite the section below.
OFFICERS_REQUIRE_BOARD_SEAT=true
OFFICERS_REQUIRE_BOARD_SEAT_CITATION=

# --- Cookies and transport security -------------------------------------------
# Secure cookies. false is allowed only for http://localhost; production refuses false.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# Session lifetime in seconds (default 12 hours).
SESSION_COOKIE_AGE=43200
# Production only: redirect HTTP to HTTPS (default true there).
# SECURE_SSL_REDIRECT=true
# Production only: HSTS max-age. Start at 3600 on the POC; 31536000 in production.
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false

# --- Sign-in (decisions D3, D5, D6) --------------------------------------------
# Check new passwords against Have I Been Pwned (k-anonymity; fail-open).
PASSWORD_BREACH_CHECK=true
PASSWORD_BREACH_CHECK_TIMEOUT=3
# Lockout: failures for one email from one IP, and how long the lockout lasts.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=0.5

# --- Reverse proxy (decision D6) ---------------------------------------------
# Networks allowed to supply the client IP and HTTPS headers. Empty = none
# (local development). docker-compose.tunnel.yml sets the cloudflared address.
TRUSTED_PROXY_CIDRS=
# Production refuses to start with no trusted proxy (rate limits would key on
# the proxy's address). Set true only if clients really connect directly.
# NO_TRUSTED_PROXY=false
# Header carrying the real client IP from the trusted proxy.
CLIENT_IP_HEADER=CF-Connecting-IP
# POC/production only: Cloudflare tunnel token (Zero Trust -> Tunnels).
# TUNNEL_TOKEN=
# POC VM only (read by infra/poc/portal-agent.sh, not by the app): the
# "Install update" button installs only from main, which receives only
# CI-tested merges. Name one other branch here only for a deliberate test.
# ALLOW_BRANCH=

# --- Postgres (decision Q8: two roles) ----------------------------------------
# Superuser password, used only by the postgres container's first-run init script.
POSTGRES_SUPERUSER_PASSWORD=local-dev-superuser-password
# Application database name.
HOA_DB_NAME=hoa
# Owner role: owns the schema; used ONLY by the one-shot migrate service.
HOA_OWNER_DB_USER=hoa_owner
HOA_OWNER_DB_PASSWORD=local-dev-owner-password
# App role: what web and worker connect as. No TRUNCATE, no DDL, and no
# UPDATE/DELETE on append-only tables.
HOA_APP_DB_USER=hoa_app
HOA_APP_DB_PASSWORD=local-dev-app-password
# Seconds to keep DB connections open (0 = close after each request).
# DATABASE_CONN_MAX_AGE=60
#
# Outside docker compose, set these directly instead of the HOA_* values above:
#   DATABASE_URL=postgres://<app user>:<password>@<host>:5432/<db>
#   DB_APP_ROLE=<app user>

# --- Object storage (S3-compatible) -------------------------------------------
# Local: SeaweedFS container. Production: Cloudflare R2
# (https://<account id>.r2.cloudflarestorage.com). The bucket must be private.
# Local file store (SeaweedFS) runs only with this profile. For Cloudflare R2,
# remove it and set S3_ENDPOINT_URL to https://<account id>.r2.cloudflarestorage.com,
# S3_REGION=auto (infra/poc/move-files-to-r2.sh does this on the VM).
COMPOSE_PROFILES=local-store
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_BUCKET=hoa-private
S3_ACCESS_KEY_ID=local-dev-access-key
S3_SECRET_ACCESS_KEY=local-dev-secret-key
# R2 uses "auto".
S3_REGION=us-east-1
# Unused: files are streamed through the app after an authorization check,
# never handed out as signed URLs. Kept for compatibility.
S3_SIGNED_URL_TTL_SECONDS=300

# --- Documents -------------------------------------------------------------------
# Largest upload accepted, in bytes (default 25 MB).
DOCUMENT_MAX_BYTES=26214400
# Malware scanning: "none" (files recorded as unscanned) or "clamd" with
# DOCUMENT_CLAMD_ADDRESS=host:3310 pointing at a ClamAV daemon.
DOCUMENT_SCANNER=none
DOCUMENT_CLAMD_ADDRESS=
# Only allow downloads of files a scanner has marked clean. After enabling a
# scanner, run `manage.py rescan_files --actor ... --reason ...`.
DOCUMENT_REQUIRE_CLEAN_SCAN=false
# The POC/production overlay (docker-compose.tunnel.yml) runs a ClamAV
# container; there use DOCUMENT_SCANNER=clamd, DOCUMENT_CLAMD_ADDRESS=clamav:3310
# and DOCUMENT_REQUIRE_CLEAN_SCAN=true (decision D21).
# Most files on one ARC request, violation or invoice (files are permanent).
ATTACHMENTS_PER_OBJECT_MAX=40
# Days an uploaded home and owner register file is kept before it is removed
# automatically (D54); the board can remove it sooner. The record of the
# import (who, when, counts) stays.
REGISTER_IMPORT_FILE_DAYS=30

# --- Sign-in ------------------------------------------------------------------
# Seconds a new login has, in the browser that accepted the invitation or
# redeemed a reset code, to add a passkey or authenticator app.
MFA_ENROLLMENT_WINDOW_SECONDS=3600

# --- Money ------------------------------------------------------------------
# Emergency off switch for late fees (decision D21: the board may post them,
# and may switch on automatic posting in Community settings).
LEDGER_LATE_FEES_ENABLED=true
# Online payments (D32-payments): "none" or "stripe" (Stripe hosted Checkout;
# the app never handles card or bank numbers). Put the key here on the server
# only, never in the repository or a chat: a Stripe RESTRICTED key (rk_test_...
# while testing) with only the rights listed in docs/runbook.md "Online
# payments (Stripe)". Test keys are refused when DEPLOYMENT_STAGE=production;
# live keys are refused unless DEPLOYMENT_STAGE=production and
# PAYMENTS_LIVE_ALLOWED=true. The board also switches on the
# "online_payments" feature in Admin -> Features.
PAYMENTS_PROVIDER=none
STRIPE_SECRET_KEY=
PAYMENTS_LIVE_ALLOWED=false

# --- Installable app and alerts (optional; the board also switches the
# "push" and "sms" features on in Admin -> Features) ---------------------------
# Push notifications: create a key pair once with
#   python manage.py generate_vapid_keys
# and keep the private key secret. Empty = push off. The subject is a
# contact for the push services, e.g. mailto:board@example.com.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Push services the portal may post to (comma-separated). Empty or unset =
# the usual browser push services (Google, Mozilla, Apple, Microsoft).
# PUSH_ALLOWED_HOSTS=
# Text messages for urgent notices: "none" (off) or "twilio" (Twilio, or a
# Twilio-compatible service at SMS_API_BASE). SMS_FROM is the sending number
# in +1XXXXXXXXXX form. Never commit real values.
SMS_PROVIDER=none
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=
# Twilio-compatible API address (default Twilio).
SMS_API_BASE=https://api.twilio.com

# Bank feed (optional; the board switches "bank_feeds" on in Admin -> Features).
# BANK_FEED_TOKEN_KEY encrypts stored bank access tokens: a long random value,
# e.g. `openssl rand -hex 32`. Connecting a bank is refused while it is empty.
# Teller (teller.io, free developer tier): TELLER_ENVIRONMENT is sandbox,
# development (the free tier for real accounts) or production. Certificate and
# key: base64 -w0 of the PEM files from the Teller dashboard. Never commit them.
BANK_FEED_TOKEN_KEY=
TELLER_APPLICATION_ID=
TELLER_ENVIRONMENT=sandbox
TELLER_CERTIFICATE_B64=
TELLER_PRIVATE_KEY_B64=

# --- Email --------------------------------------------------------------------
# Local: Mailpit catches everything; read it at http://localhost:8025.
# Production (Hostinger): EMAIL_HOST=smtp.hostinger.com, EMAIL_PORT=465 with
# EMAIL_USE_SSL=true (or 587 with EMAIL_USE_TLS=true). Use a dedicated mailbox.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Oak Creek Farms HOA <portal@example.com>
# POC ONLY: deliver every message to this one address instead of the real
# recipient (decision Q2). Leave empty in production.
EMAIL_REDIRECT_ALL_TO=

# Decision D21: a new board seat needs a second board member's approval.
# true in production; the POC sets false (infra/poc/make-env.sh).
BOARD_SEAT_SECOND_APPROVAL=true

# ARC neighbour sign-off: days a single-use emailed link stays valid.
SIGNOFF_LINK_DAYS=14
# Gemini reads uploaded signed ARC forms (optional). The free tier may use
# submitted content to improve Google's products: use a paid key once forms
# carry real names (decision D21). Leave empty to enter sign-offs by hand.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Off-site backups (optional but recommended): a bucket the HOA owns, e.g.
# Cloudflare R2, separate from the portal's file store. Backups are encrypted
# on the VM before upload. Leave BACKUP_S3_BUCKET empty for local-only.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
